# Copy to `.env` next to docker-compose.yml and fill in as needed.
# Every value here has a working default in docker-compose.yml.

# ---- ports on the host ----
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ---- frontend build ----
# "/api" = same-origin, proxied by nginx to the backend container (recommended).
# Set an absolute URL instead to point the bundle at a remote backend.
REACT_APP_API_BASE_URL=/api

# ---- Catalyst credentials (only needed for real data) ----
# Leave CATALYST_INJECT_HEADERS=false and the container still boots and serves
# "/" but every Data Store / Stratus / job route returns 500.
CATALYST_INJECT_HEADERS=false
CATALYST_PROJECT_ID=30561000000020169
CATALYST_PROJECT_KEY=
CATALYST_ENVIRONMENT=Development
CATALYST_PROJECT_DOMAIN=
# OAuth access token; expires (~1h). Development convenience only.
CATALYST_ACCESS_TOKEN=
