# Copy to `.env` next to docker-compose.yml and fill in as needed.
# Every value here has a working default in docker-compose.yml.

# ---- ports on the host ----
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ---- frontend build ----
# "/api" = same-origin, proxied by nginx to the backend container (recommended).
# Set an absolute URL instead to point the bundle at a remote backend.
REACT_APP_API_BASE_URL=/api

# ---- Catalyst auth (required for real data) ----
# ONE value makes the backend work on ANY machine — no catalyst login, no
# project key, no host files, and it does not expire like an access token.
#
# Generate it once on a machine that is already logged in:
#     catalyst token:generate            # mint a new token
#     catalyst token:generate --current  # or print the one already in use
#
# Then paste it here (and into .env on every other machine).
# Treat it as a secret: it is a long-lived credential for the whole project.
CATALYST_TOKEN=

# ---- legacy: raw x-zc-* header injection ----
# Only for appsail-nodejs/Dockerfile (the plain `node index.js` image), not the
# CLI-based default. Needs a project key AND an access token that expires ~1h.
CATALYST_INJECT_HEADERS=false
CATALYST_PROJECT_ID=30561000000020169
CATALYST_PROJECT_KEY=
CATALYST_ENVIRONMENT=Development
CATALYST_PROJECT_DOMAIN=
CATALYST_ACCESS_TOKEN=
